# Copy to .env and edit. The offline mock run needs NONE of these.

# mock (offline, default) | live
ROUTER_MODE=mock

# ---- Small tier (local, $0) ------------------------------------------------
SMALL_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434

# ---- Large tier: pick ONE backend -----------------------------------------
# openai_compatible | anthropic | bedrock | ollama
LARGE_BACKEND=openai_compatible

# --- openai_compatible (Groq is just one of these) ---
# Groq:       LARGE_BASE_URL=https://api.groq.com/openai/v1   LARGE_API_KEY_ENV=GROQ_API_KEY
# OpenAI:     LARGE_BASE_URL=https://api.openai.com/v1        LARGE_API_KEY_ENV=OPENAI_API_KEY
# Together:   LARGE_BASE_URL=https://api.together.xyz/v1      LARGE_API_KEY_ENV=TOGETHER_API_KEY
# OpenRouter: LARGE_BASE_URL=https://openrouter.ai/api/v1     LARGE_API_KEY_ENV=OPENROUTER_API_KEY
LARGE_MODEL=openai/gpt-oss-120b
LARGE_BASE_URL=https://api.groq.com/openai/v1
LARGE_API_KEY_ENV=GROQ_API_KEY
GROQ_API_KEY=

# Per-1M-token prices for whichever large model you chose (USD).
LARGE_PRICE_IN=0.15
LARGE_PRICE_OUT=0.60

# --- anthropic (Claude as the large tier) ---
# LARGE_BACKEND=anthropic
# LARGE_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=
# LARGE_PRICE_IN=1.00
# LARGE_PRICE_OUT=5.00

# --- bedrock (uses your AWS credentials) ---
# LARGE_BACKEND=bedrock
# LARGE_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
# AWS_REGION=us-east-1

# ---- Harness knobs ---------------------------------------------------------
EVAL_SIZE=120
SC_K=3
VERIFIER_THRESHOLD=0.5
CAL_MIN_ACC=0.55
SEED=7
